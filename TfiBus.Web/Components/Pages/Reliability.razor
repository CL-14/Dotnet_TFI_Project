@page "/reliability"
@inject CollectorReader Reader
@inject Dictionary<string, RouteInfo> RoutesById

<PageTitle>Reliability</PageTitle>
<h1>How many scheduled buses never show up?</h1>

<p>
    For each finished day, this compares the bus trips the NTA predicts with the trips that a tracked
    vehicle actually reported. <strong>Silent</strong> trips are ones the NTA still lists as scheduled
    that no vehicle ever reported. These are estimates: a silent trip may be a bus that ran without being tracked.
</p>

<table>
    <thead>
        <tr>
            <th>Date</th>
            <th>Predicted</th>
            <th>Cancelled</th>
            <th>Never seen</th>
            <th>Silent</th>
            <th>Silent %</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DailyReliability day in days)
        {
            <tr>
                <td>@day.StartDate</td>
                <td>@day.Predicted</td>
                <td>@day.Cancelled</td>
                <td>@day.NeverSeen</td>
                <td>@day.Silent</td>
                <td>@(day.SilentPercent.ToString("F1"))%</td>
            </tr>
        }
    </tbody>
</table>

<h2>Routes with the most silent trips</h2>
<p>Over the last 14 complete days, routes with at least 100 trips.</p>
<table>
    <thead>
        <tr>
            <th>Route</th>
            <th>Predicted</th>
            <th>Silent</th>
            <th>Silent %</th>
        </tr>
    </thead>
    <tbody>
        @foreach (RouteReliability route in worstRoutes)
        {
            <tr>
                <td>@route.Name</td>
                <td>@route.Predicted</td>
                <td>@route.Silent</td>
                <td>@(route.SilentPercent.ToString("F1"))%</td>
            </tr>
        }
    </tbody>
</table>

<p><small>Source: National Transport Authority, provided "as is". Only bus routes (route type 3 in the schedule) are
included.</small></p>

@code {
    private List<DailyReliability> days = new List<DailyReliability>();
    private List<RouteReliability> worstRoutes = new List<RouteReliability>();

    // Reads one row per day and route, then totals them for buses only.
    protected override void OnInitialized()
    {
        List<RouteDayReliability> rows = Reader.GetRouteDayReliability(14, 500);
        days = ReliabilityCalculator.Daily(rows, RoutesById);
        worstRoutes = ReliabilityCalculator.ByRoute(rows, RoutesById, 100).Take(15).ToList();
    }
}
