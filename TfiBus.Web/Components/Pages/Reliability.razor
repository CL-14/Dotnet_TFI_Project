@page "/reliability"
@using System.Globalization
@inject CollectorReader Reader
@inject Dictionary<string, RouteInfo> RoutesById

<PageTitle>Reliability</PageTitle>
<h1>How many scheduled buses never show up?</h1>

<p class="lead">
    For each finished day, this compares the bus trips the NTA predicts with the trips that a tracked
    vehicle actually reported.
</p>
<p>
    <strong>Silent</strong> trips are ones the NTA still lists as scheduled that no vehicle ever reported.
    These are estimates: a silent trip may be a bus that ran without being tracked.
</p>

@* Bootstrap "card": a bordered box with a header. "table-striped" shades every other row,
   "table-responsive" lets the table scroll sideways on a phone instead of breaking the layout. *@
<section class="card mb-4">
    <h2 class="card-header h5">Day by day</h2>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    @* scope="col" tells screen readers this cell is the heading for its column. *@
                    <th scope="col">Date</th>
                    <th scope="col" class="text-end">Predicted</th>
                    <th scope="col" class="text-end">Cancelled</th>
                    <th scope="col" class="text-end">Never seen</th>
                    <th scope="col" class="text-end">Silent</th>
                    <th scope="col" class="text-end">Silent %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DailyReliability day in days)
                {
                    <tr>
                        <td>@FriendlyDate(day.StartDate)</td>
                        @* "N0" adds thousands separators: 16748 becomes 16,748. "text-end" right-aligns numbers*@
                        <td class="text-end">@day.Predicted.ToString("N0")</td>
                        <td class="text-end">@day.Cancelled.ToString("N0")</td>
                        <td class="text-end">@day.NeverSeen.ToString("N0")</td>
                        <td class="text-end">@day.Silent.ToString("N0")</td>
                        <td class="text-end">@(day.SilentPercent.ToString("F1"))%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card mb-4">
    <h2 class="card-header h5">Routes with the most silent trips</h2>
    <div class="card-body pb-0">
        <p class="card-text">Over the last 14 complete days, routes with at least 100 trips.</p>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col">Route</th>
                    <th scope="col" class="text-end">Predicted</th>
                    <th scope="col" class="text-end">Silent</th>
                    <th scope="col" class="text-end">Silent %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RouteReliability route in worstRoutes)
                {
                    <tr>
                        <td>@route.Name</td>
                        <td class="text-end">@route.Predicted.ToString("N0")</td>
                        <td class="text-end">@route.Silent.ToString("N0")</td>
                        <td class="text-end">@(route.SilentPercent.ToString("F1"))%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<p><small>Source: National Transport Authority, provided "as is". Only bus routes (route type 3 in the schedule) are
included.</small></p>

@code {
    private List<DailyReliability> days = new List<DailyReliability>();
    private List<RouteReliability> worstRoutes = new List<RouteReliability>();

    // Reads one row per day and route, then totals them for buses only.
    protected override void OnInitialized()
    {
        List<RouteDayReliability> rows = Reader.GetRouteDayReliability(14, 500);
        days = ReliabilityCalculator.Daily(rows, RoutesById);
        worstRoutes = ReliabilityCalculator.ByRoute(rows, RoutesById, 100).Take(15).ToList();
    }

    // The feed's dates look like "20261126"; this shows "Thu 26 Nov 2026" instead.
    // TryParseExact returns false (rather than throwing) if a date is not in that form, and then
    // the original text is shown, so one odd row cannot break the page.
    private static string FriendlyDate(string yyyymmdd)
    {
        if (DateTime.TryParseExact(yyyymmdd, "yyyyMMdd", CultureInfo.InvariantCulture,
                                   DateTimeStyles.None, out DateTime date))
        {
            return date.ToString("ddd d MMM yyyy");
        }
        return yyyymmdd;
    }
}
