@inject CollectorReader Reader
@* IDisposable lets Blazor tell this component to clean up (stop its timer) when it is removed. *@
@implements IDisposable

@* "mb-0" is a Bootstrap class that removes the paragraph's bottom margin,
   so the text sits centred in the top bar of the layout. *@
@if (minutes == null)
{
    <p class="mb-0">No data has been collected yet.</p>
}
else if (minutes > 10)
{
    @* role="alert" makes screen readers announce the warning. *@
    <p class="mb-0" role="alert" style="color:#b00020"><strong>Warning:</strong> the last successful update was
        @minutes minutes ago, so live information may be out of date.</p>
}
else
{
    <p class="mb-0"><small>Live data updated @minutes minute(s) ago.</small></p>
}

@code {
    private long? minutes;

    // A timer that "ticks" every 60 seconds. It is needed because this component lives in the
    // layout, which stays on screen while the user moves between pages, so OnInitialized only
    // runs once and the number would otherwise never change.
    private PeriodicTimer? timer;

    // Reads the age of the newest successful poll when the component is created,
    // then starts the refresh loop.
    protected override void OnInitialized()
    {
        minutes = Reader.MinutesSinceLastSuccessfulPoll();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        // "_ =" starts the loop without waiting for it; it keeps running in the background.
        _ = RefreshEveryMinute();
    }

    // Each tick re-reads the database and redraws the banner.
    // WaitForNextTickAsync returns false once the timer is disposed, which ends the loop.
    private async Task RefreshEveryMinute()
    {
        while (await timer!.WaitForNextTickAsync())
        {
            minutes = Reader.MinutesSinceLastSuccessfulPoll();
            // The tick runs outside Blazor's normal flow, so InvokeAsync hands the redraw
            // (StateHasChanged) back to the component safely.
            await InvokeAsync(StateHasChanged);
        }
    }

    // Called by Blazor when the component is removed (e.g. the browser tab closes).
    // Stopping the timer here prevents it from running forever on the server.
    public void Dispose()
    {
        timer?.Dispose();
    }
}
